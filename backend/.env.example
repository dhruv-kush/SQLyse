# Copy this file to .env and fill in real values. Never commit .env itself.

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-random-string

# CORS - frontend origin(s), comma separated
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Scanner behavior
USE_MOCK_SCANNER=true
MAX_CONCURRENT_SCANS=3
REQUEST_TIMEOUT_SECONDS=10
MAX_PAGES_PER_SCAN=25
MAX_RESPONSE_BYTES=2097152

# Optional: AI explanation module (only needed if you wire a real LLM API)
AI_API_KEY=
